{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
  ],

  // This fork deliberately extends no org-level preset. It previously extended
  // 'github>netboxlabs/renovate', which is not reachable from here (404, even
  // unauthenticated). An unresolvable preset aborts the entire Renovate run, so
  // no dependency update ever landed. Everything the central config used to
  // supply — schedule and timezone — is therefore set explicitly below.
  timezone: 'Etc/UTC',
  schedule: ['before 4am every weekday'],

  labels: ['dependencies'],

  // Bump lower bounds in pyproject.toml even when the constraint already allows the new version
  rangeStrategy: 'bump',

  packageRules: [
    // Don't bump requires-python — it defines minimum supported version, not installed version
    {
      matchDepNames: ['python'],
      matchManagers: ['pep621'],
      enabled: false,
    },

    // Python
    {
      description: 'Group non-major Python dependency updates',
      matchManagers: ['pep621', 'uv'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'non-major Python dependencies',
    },

    // GitHub Actions
    {
      description: 'GitHub Actions - SHA-pin and group non-major updates',
      matchManagers: ['github-actions'],
      pinDigests: true,
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      groupName: 'non-major GitHub Actions',
    },

    // Docker
    {
      description: 'Group non-major Docker dependency updates',
      matchManagers: ['dockerfile'],
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      groupName: 'non-major Docker dependencies',
    },

    // Major updates always separate for manual review
    {
      description: 'Separate major updates for manual review',
      matchUpdateTypes: ['major'],
      groupName: null,
    },

    // Security
    {
      description: 'Prioritise security updates',
      matchCategories: ['security'],
      groupName: null,
      labels: ['dependencies', 'security'],
      minimumReleaseAge: null,
      prPriority: 10,
    },
  ],

  // Security fixes must not wait for the weekday schedule above. Four advisories
  // (three HIGH in mcp, one in pydantic-settings) sat unnoticed for nine days
  // because nothing was raising them at all.
  // Prioritisation lives in the matchCategories:['security'] packageRule above;
  // prPriority is not accepted inside vulnerabilityAlerts.
  vulnerabilityAlerts: {
    labels: ['security'],
    minimumReleaseAge: null,
    schedule: ['at any time'],
  },

  // Raise advisories from the OSV database too, not only GitHub's alerts.
  osvVulnerabilityAlerts: true,
}
