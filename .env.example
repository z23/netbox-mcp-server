# NetBox MCP Server Configuration
# Copy this file to .env and customize for your environment

# ===== Core NetBox Configuration (REQUIRED) =====
NETBOX_URL=https://netbox.example.com/
NETBOX_TOKEN=your_api_token_here
# Per-request timeout in seconds for NetBox API calls (default: 30)
# NETBOX_TIMEOUT=30

# ===== Transport Configuration =====
# Options: stdio (default, for Claude Desktop/Code) or http (for web clients)
TRANSPORT=stdio

# ===== HTTP Transport Settings =====
# Only used when TRANSPORT=http
HOST=127.0.0.1
PORT=8000
# Bearer token required on the HTTP endpoint. When unset, the HTTP transport is
# UNAUTHENTICATED. Clients then send 'Authorization: Bearer <token>'.
# MCP_AUTH_TOKEN=a-strong-random-token

# ===== Write Tools (opt-in; off by default) =====
# Register create/update/delete tools. The NetBox token must have write perms.
# ENABLE_WRITES=false
# Object types the write tools refuse to mutate (JSON list). Entries ending in
# '.*' match a whole app label. Defense-in-depth on top of NetBox token scoping.
# No default is reproduced here on purpose: a stale copy silently REMOVES
# protection. See DEFAULT_WRITE_DENIED_TYPES in src/netbox_mcp_server/config.py
# for the current list, and the write-safeguards note in README.md. Set this only
# to deny MORE than the default, or to '[]' to rely on token scoping alone.
# WRITE_DENIED_TYPES=
# The server REFUSES to start with writes enabled on HTTP and no MCP_AUTH_TOKEN.
# Nothing in the server restricts the endpoint to localhost — only your network
# placement does. Set this to true only when you have confirmed that placement.
# ALLOW_UNAUTHENTICATED_WRITES=false

# ===== Plugin Object Type Discovery (opt-in; off by default) =====
# Auto-discover plugin object types from NetBox at startup. Core types are always
# available; this adds plugin types (e.g. netbox_dns.zone) to the tool surface.
# ENABLE_PLUGIN_DISCOVERY=false

# ===== Security Settings =====
# Set to false only for testing with self-signed certificates
VERIFY_SSL=true
# Browser origins allowed for HTTP CORS. The server REFUSES to start on '*' with
# no MCP_AUTH_TOKEN set.
CORS_ORIGINS='["http://localhost:6274"]'

# ===== Logging Configuration =====
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
